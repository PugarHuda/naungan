{
  "buildCommand": "npx hardhat compile && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/relayer.js": {
      "includeFiles": "{web/deployment.json,artifacts/contracts/Naungan.sol/Naungan.json,artifacts/@semaphore-protocol/contracts/Semaphore.sol/Semaphore.json}",
      "maxDuration": 60
    },
    "api/programs.js": {
      "includeFiles": "{web/deployment.json,artifacts/contracts/Naungan.sol/Naungan.json}",
      "maxDuration": 60
    },
    "api/feed.js": {
      "includeFiles": "{web/deployment.json,artifacts/contracts/Naungan.sol/Naungan.json}",
      "maxDuration": 60
    },
    "api/cap.js": {
      "includeFiles": "{web/deployment.json,artifacts/contracts/Naungan.sol/Naungan.json}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/relay",
      "destination": "/api/relayer?route=/relay"
    },
    {
      "source": "/transfer",
      "destination": "/api/relayer?route=/transfer"
    },
    {
      "source": "/pin",
      "destination": "/api/relayer?route=/pin"
    },
    {
      "source": "/push-key",
      "destination": "/api/relayer?route=/push-key"
    },
    {
      "source": "/subscribe",
      "destination": "/api/relayer?route=/subscribe"
    },
    {
      "source": "/notify",
      "destination": "/api/relayer?route=/notify"
    },
    {
      "source": "/health",
      "destination": "/api/relayer?route=/health"
    },
    {
      "source": "/feed.xml",
      "destination": "/api/feed"
    },
    {
      "source": "/cap.xml",
      "destination": "/api/cap"
    },
    {
      "source": "/programs.geojson",
      "destination": "/api/programs?format=geojson"
    },
    {
      "source": "/programs.csv",
      "destination": "/api/programs?format=csv"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self'; worker-src 'self' blob:; connect-src 'self' https://naungan.vercel.app https://sepolia.base.org https://base-sepolia.blockscout.com https://base-sepolia.easscan.org https://flood-api.open-meteo.com https://ensemble-api.open-meteo.com https://archive-api.open-meteo.com https://geocoding-api.open-meteo.com https://api-bdc.io https://open.er-api.com https://goadmin.ifrc.org https://snark-artifacts.pse.dev; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
